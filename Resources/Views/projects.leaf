<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title)</title>
    <link rel="stylesheet" href="/projects.css" data-turbo-track="reload">
    <link rel="stylesheet" href="/main.css" data-turbo-track="reload">
</head>
<body>
    <div class="container">
        <h1 class="title">Portfolio</h1>
        <a href="/" class="back-link">
            <span class="arrow">←</span> Back to main menu
        </a>

        <div class="fib-canvas">
            #for(project in projects):
            #if(isFirst):
            <a href="/projects/#(project.id)" class="square s4 project-card" data-description="#(project.description)">
                <div class="quarter-circle c4"></div>
                <span class="project-title">#(project.title)</span>
            </a>
            <div class="fib-right">
            #elseif(index == 1):
                <a href="/projects/#(project.id)" class="square s3 project-card" data-description="#(project.description)">
                    <div class="quarter-circle c3"></div>
                    <span class="project-title">#(project.title)</span>
                </a>
                <div class="fib-bottom">
            #elseif(index == 2):
                    <a href="/projects/#(project.id)" class="square s2 project-card" data-description="#(project.description)">
                        <div class="quarter-circle c2"></div>
                        <span class="project-title">#(project.title)</span>
                    </a>
            #elseif(index == 3):
                    <a href="/projects/#(project.id)" class="square s1 project-card" data-description="#(project.description)">
                        <div class="quarter-circle"></div>
                        <span class="project-title">#(project.title)</span>
                    </a>
                </div>
            </div>
            #endif
            #endfor
        </div>

        <div class="tooltip" id="tooltip">
            This is a short description of the project. This box follows the cursor around.
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
