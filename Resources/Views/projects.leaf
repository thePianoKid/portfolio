<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title)</title>
    <link rel="stylesheet" href="/projects.css" data-turbo-track="reload">
    <link rel="stylesheet" href="/main.css" data-turbo-track="reload">
</head>
<body>
    <div class="container">
        <h1 class="title">Portfolio</h1>
        <a href="/" class="back-link">
            <span class="arrow">←</span> Back to main menu
        </a>

        <div class="fib-canvas">
            <div class="square s4 project-card" data-description="This is a short description of the project. This box follows the cursor around.">
                <div class="quarter-circle c4"></div>
                <span class="project-title">train.ai</span>
            </div>
            <div class="fib-right">
                <div class="square s3 project-card" data-description="This is a short description of the project. This box follows the cursor around.">
                    <div class="quarter-circle c3"></div>
                    <span class="project-title">Retell</span>
                </div>
                <div class="fib-bottom">
                    <div class="square s2 project-card" data-description="This is a short description of the project. This box follows the cursor around.">
                        <div class="quarter-circle c2"></div>
                        <span class="project-title">Fitness app</span>
                    </div>
                    <div class="square s1 project-card" data-description="This is a short description of the project. This box follows the cursor around.">
                        <div class="quarter-circle"></div>
                        <span class="project-title">Notion x Shopify</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="tooltip" id="tooltip">
            This is a short description of the project. This box follows the cursor around.
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
